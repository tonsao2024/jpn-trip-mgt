{
  "name": "jpn-trip-mgt",
  "description": "Fuji Trip — แอปวางแผนทริปญี่ปุ่น (แผนการเดินทาง, แผนที่, ค่าใช้จ่าย, การเคลียร์ยอด)",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules\"",
    "test:all": "npm run lint && npm test && npm run test:rules",
    "deploy": "firebase deploy --only hosting,firestore:rules,storage"
  },
  "dependencies": {
    "chart.js": "^4.4.9",
    "firebase": "^11.10.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^2.5.2",
    "leaflet": "^1.9.4",
    "lucide": "^0.525.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^9.30.0",
    "firebase-tools": "^14.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
